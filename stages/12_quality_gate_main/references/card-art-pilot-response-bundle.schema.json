{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polimatch.com.br/schemas/card-art-pilot-176-response-bundle.schema.json",
  "title": "Bundle transitório de respostas individuais do piloto #176",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "batch",
    "receiptRegistrySha256",
    "responses"
  ],
  "properties": {
    "protocol": {
      "const": "card-art-pilot-176-v2-response-bundle"
    },
    "batch": {
      "$ref": "#/$defs/batchIdentity"
    },
    "receiptRegistrySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "batchIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "manifestSha256",
        "assets"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "assets": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/batchAsset"
          }
        }
      }
    },
    "batchAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blindCode",
        "sha256"
      ],
      "properties": {
        "blindCode": {
          "enum": [
            "P01",
            "P02",
            "P03",
            "P04",
            "P05",
            "P06",
            "P07",
            "P08"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
